# ---- Minecraft 连接 ----
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=MyBot
MC_AUTH=offline
MC_PASSWORD=

# ---- AI（OpenAI 兼容接口，DeepSeek/Kimi/本地 Ollama 等均可）----
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200
AI_INTERVAL_MS=1500
AI_PLAN_AHEAD=true

# ---- 控制面板 API ----
API_HOST=127.0.0.1
API_PORT=8787

# ---- 生存兜底（可选，不配置则用默认值）----
REACTIVE_LOW_HEALTH_FLEE=8
REACTIVE_CRITICAL_LOGOUT=4
REACTIVE_HOSTILE_SCAN=16
REACTIVE_ENGAGE_OVER_FLEE=false
