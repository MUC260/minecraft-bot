# ---- Minecraft connection ----
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=MyBot
MC_AUTH=offline
MC_PASSWORD=
MC_VERSION=
MC_RECONNECT=true
MC_RECONNECT_BASE_DELAY_MS=3000
MC_RECONNECT_MAX_DELAY_MS=60000
MC_RECONNECT_MAX_ATTEMPTS=-1
MC_RECONNECT_AFTER_EMERGENCY=false
MC_PLUGIN_PASSWORD=
MC_PLUGIN_LOGIN_COMMANDS=/login {password}
MC_PLUGIN_REGISTER_COMMANDS=
MC_PLUGIN_AUTH_DELAY_MS=1500

# ---- AI (OpenAI-compatible API: DeepSeek/Kimi/Ollama etc) ----
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1200
AI_INTERVAL_MS=1500
AI_PLAN_AHEAD=true

# ---- Control panel API ----
API_HOST=127.0.0.1
API_PORT=8787

# ---- Logging ----
LOG_FILE=true
LOG_DIR=logs
LOG_NAME=agent.log

# ---- Survival / combat ----
REACTIVE_LOW_HEALTH_FLEE=8
REACTIVE_CRITICAL_LOGOUT=4
REACTIVE_HOSTILE_SCAN=16
REACTIVE_ENGAGE_OVER_FLEE=false
REACTIVE_DEFEND_WHEN_ATTACKED_WINDOW_MS=2000
REACTIVE_FLEE_CLOSE_REPATH_DISTANCE=3
REACTIVE_FLEE_CLOSE_REPATH_MS=500
REACTIVE_MELEE_STRAFE_ENABLED=true
REACTIVE_MELEE_STRAFE_INTERVAL_MS=900
REACTIVE_MELEE_ATTACK_RANGE=3.5
REACTIVE_MELEE_ATTACK_INTERVAL_MS=500
REACTIVE_DEFENSIVE_ATTACK_RANGE=4
